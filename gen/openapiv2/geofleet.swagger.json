{
  "swagger": "2.0",
  "info": {
    "title": "Geofleet Tracking API",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "TrackingService"
    },
    {
      "name": "UserService"
    },
    {
      "name": "RideService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {},
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1AcceptRideResponse": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/definitions/v1UniversalRideResponse"
        }
      }
    },
    "v1CancelRideResponse": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/definitions/v1UniversalRideResponse"
        },
        "isSuccess": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "v1CheckDuplicatedPhoneResponse": {
      "type": "object",
      "properties": {
        "isDuplicated": {
          "type": "boolean"
        }
      }
    },
    "v1CompleteRideResponse": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/definitions/v1UniversalRideResponse"
        },
        "durationInSecond": {
          "type": "number",
          "format": "double"
        },
        "totalTravelDistanceM": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "v1CreateUserProfileResponse": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        }
      }
    },
    "v1GetUserProfileResponse": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "title": "uuid"
        },
        "fullname": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "bod": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "$ref": "#/definitions/v1UserRole"
        },
        "score": {
          "type": "number",
          "format": "double"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1LatLng": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "format": "double"
        },
        "lng": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "v1LoginResponse": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "user": {
          "$ref": "#/definitions/v1GetUserProfileResponse"
        },
        "accessToken": {
          "type": "string",
          "title": "Senior tip: Trả về token thay vì role/address"
        }
      }
    },
    "v1Password": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      }
    },
    "v1PaymentMethod": {
      "type": "string",
      "enum": [
        "PAYMENT_METHOD_UNSPECIFIED",
        "PAYMENT_METHOD_CASH",
        "PAYMENT_METHOD_WALLET",
        "PAYMENT_METHOD_CARD"
      ],
      "default": "PAYMENT_METHOD_UNSPECIFIED"
    },
    "v1RequestRideResponse": {
      "type": "object",
      "properties": {
        "rideId": {
          "type": "string"
        },
        "passengerId": {
          "type": "string"
        },
        "driverId": {
          "type": "string"
        },
        "estimateFare": {
          "type": "number",
          "format": "float"
        },
        "finalFare": {
          "type": "number",
          "format": "float"
        },
        "rideStatus": {
          "$ref": "#/definitions/v1RideStatus"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "title": "string cancel_reason = 12;"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1RideStatus": {
      "type": "string",
      "enum": [
        "RIDE_STATUS_UNSPECIFIED",
        "RIDE_STATUS_CREATED",
        "RIDE_STATUS_MATCHING",
        "RIDE_STATUS_ACCEPTED",
        "RIDE_STATUS_ARRIVED",
        "RIDE_STATUS_IN_PROGRESS",
        "RIDE_STATUS_COMPLETED",
        "RIDE_STATUS_CANCELLED"
      ],
      "default": "RIDE_STATUS_UNSPECIFIED",
      "title": "- RIDE_STATUS_UNSPECIFIED: Giá trị mặc định\n - RIDE_STATUS_CREATED: User requested\n - RIDE_STATUS_MATCHING: System pinging drivers\n - RIDE_STATUS_ACCEPTED: Driver accepted\n - RIDE_STATUS_ARRIVED: Driver at pick-up\n - RIDE_STATUS_IN_PROGRESS: In the car\n - RIDE_STATUS_COMPLETED: Arrived destination\n - RIDE_STATUS_CANCELLED: Trip cancelled"
    },
    "v1RideStatusUpdateResponse": {
      "type": "object",
      "properties": {
        "rideStatus": {
          "$ref": "#/definitions/v1RideStatus"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1StartRideResponse": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/definitions/v1UniversalRideResponse"
        }
      }
    },
    "v1SubscribeRideUpdateResponse": {
      "type": "object",
      "properties": {
        "rideId": {
          "type": "string"
        },
        "rideStatus": {
          "$ref": "#/definitions/v1RideStatusUpdateResponse"
        },
        "previousRideStatus": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1RideStatusUpdateResponse"
          },
          "title": "does not include the final one"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1TrackMultipleRidesResponse": {
      "type": "object",
      "properties": {
        "rideId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "driverId": {
          "type": "string"
        },
        "currentLocation": {
          "$ref": "#/definitions/v1LatLng"
        },
        "estimatedPrice": {
          "type": "number",
          "format": "double"
        },
        "status": {
          "type": "string",
          "title": "e.g., ON_TRIP, PICKING_UP"
        }
      }
    },
    "v1TriggerRideUpdateResponse": {
      "type": "object",
      "properties": {
        "rideId": {
          "type": "string"
        },
        "isActivated": {
          "type": "boolean"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1UniversalRideRequest": {
      "type": "object",
      "properties": {
        "rideId": {
          "type": "string"
        },
        "currentLocation": {
          "$ref": "#/definitions/v1LatLng"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1UniversalRideResponse": {
      "type": "object",
      "properties": {
        "rideId": {
          "type": "string"
        },
        "rideStatus": {
          "$ref": "#/definitions/v1RideStatus"
        }
      }
    },
    "v1UploadLocationHistoryResponse": {
      "type": "object",
      "properties": {
        "msg": {
          "type": "string"
        },
        "pointsProcessed": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "v1UserRole": {
      "type": "string",
      "enum": [
        "USER_ROLE_UNSPECIFIED",
        "USER_ROLE_PASSENGER",
        "USER_ROLE_DRIVER"
      ],
      "default": "USER_ROLE_UNSPECIFIED"
    }
  }
}
